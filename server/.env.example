PORT=5000

# ========================================================
# 🍃 MONGODB DATABASE CONFIGURATION
# ========================================================
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/eventease?retryWrites=true&w=majority

# ========================================================
# 🔑 SECURITY & ENVIRONMENT
# ========================================================
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# ========================================================
# 📧 AUTOMATED EMAIL & TICKET DISPATCH (NODEMAILER)
# ========================================================
# For production Gmail delivery:
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate a 16-character "App Password" at https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="EventEase Campus Gate <your_email@gmail.com>"
# If EMAIL_USER/EMAIL_PASS are blank, EventEase automatically creates an Ethereal test inbox.

# ========================================================
# 🤖 GOOGLE GEMINI AI CONFIGURATION (Optional)
# ========================================================
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
